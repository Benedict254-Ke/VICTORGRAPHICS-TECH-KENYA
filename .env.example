# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
DB_PATH=./db.sqlite

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=24h

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=victormbithi661@gmail.com
EMAIL_PASS=your-app-password-here
EMAIL_FROM=VictorGraphics Kenya <victormbithi661@gmail.com>
EMAIL_TO=victormbithi661@gmail.com

# Security Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com,https://www.yourdomain.com
API_KEY=your-secure-api-key-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/jpg,image/png,image/gif,image/webp,application/pdf

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# SSL Configuration (for production)
SSL_CERT_PATH=./certs/server.crt
SSL_KEY_PATH=./certs/server.key

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Redis Configuration (optional for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cloud Storage (optional for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Monitoring (optional)
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# Analytics (optional)
GOOGLE_ANALYTICS_ID=

# Development Settings
DEBUG=victorgraphics:*
MOCK_EMAIL=true
